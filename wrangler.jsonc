{
  "name": "checkscam",
  "compatibility_date": "2025-02-01",
  "main": "cloudflare-worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/favicon.ico",
      "/api/*"
    ]
  }
}
